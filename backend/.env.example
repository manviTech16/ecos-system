# Copy this file to ".env" (same folder) and fill in what you need. Never share or commit your real .env file.

# Optional: turns on AI summaries (Claude). Get a key at https://console.anthropic.com/
# Without a key the built-in NLP summarizer is used, and nothing leaves your server.
ANTHROPIC_API_KEY=

# Optional settings (defaults shown)
# ECOS_AI_MODEL=claude-sonnet-5-5
# ECOS_MAX_UPLOAD_MB=10
# ECOS_RATE_LIMIT=10
# ECOS_REDACT=1
